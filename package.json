{
  "name": "re-mcp",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Safety-first MCP server for ROM reverse-engineering workflows",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "start": "node dist/index.js",
    "test": "node --test --import tsx tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@alexaltea/capstone-js": "5.0.9",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "4.20.6",
    "typescript": "^5.7.0"
  }
}
